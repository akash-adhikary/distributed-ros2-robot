<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacles_world">
    
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Sim Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room Boundary Walls (6m x 6m Arena) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.15 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.15 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Pillar 1 -->
    <model name="pillar_1">
      <static>true</static>
      <pose>1.2 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Pillar 2 -->
    <model name="pillar_2">
      <static>true</static>
      <pose>-1.2 -1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.3 0.8 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 1 -->
    <model name="box_1">
      <static>true</static>
      <pose>-1.2 1.2 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.3 0.5 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 2 -->
    <model name="box_2">
      <static>true</static>
      <pose>1.2 -1.2 0.4 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.5 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.5 0.8</size></box></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.9 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
