<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materials -->
  <material name="chassis_color">
    <color rgba="0.15 0.18 0.22 1.0"/>
  </material>

  <material name="wheel_color">
    <color rgba="0.1 0.6 0.9 1.0"/>
  </material>

  <material name="caster_color">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <!-- BASE FOOTPRINT LINK -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
  </joint>

  <!-- BASE LINK (CHASSIS) -->
  <link name="base_link">
    <visual>
      <origin xyz="0.05 0 0.04"/>
      <geometry>
        <box size="0.28 0.22 0.08"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0.04"/>
      <geometry>
        <box size="0.28 0.22 0.08"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="1.5" x="0.28" y="0.22" z="0.08">
      <origin xyz="0.05 0 0.04" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- LEFT WHEEL -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.12 0" rpy="-${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" length="0.025" radius="0.035">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Blue</material>
    <mu1 value="1.0"/>
    <mu2 value="1.0"/>
  </gazebo>

  <!-- RIGHT WHEEL -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.12 0" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" length="0.025" radius="0.035">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Blue</material>
    <mu1 value="1.0"/>
    <mu2 value="1.0"/>
  </gazebo>

  <!-- CASTER WHEEL (FRONT) -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="0.15 0 -0.0175"/>
  </joint>

  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="0.0175"/>
      </geometry>
      <material name="caster_color"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.0175"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.05" radius="0.0175">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <gazebo reference="caster_wheel_link">
    <material>Gazebo/White</material>
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>

</robot>
